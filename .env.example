# Copy to .env (never commit .env). The Phase 0 bootstrap generates .env for you.

# --- Django ---
# pragma: allowlist nextline secret
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
API_DOCS_ENABLED=True
NUM_PROXIES=0
# CSRF_TRUSTED_ORIGINS=https://railrush.example.com

# --- Database ---
# Phases 0-1 use SQLite. Phase 2 switches this to a PostgreSQL URL (via PgBouncer).
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# --- Throttling (DRF rate strings) ---
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min

# --- Logging ---
LOG_LEVEL=INFO
