# Copy to .env (never commit .env). The Phase 0 bootstrap generates .env for you,
# and the Phase 2 bootstrap block appends the Docker section below.

# --- Django ---
# pragma: allowlist nextline secret
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
API_DOCS_ENABLED=True
NUM_PROXIES=0
# CSRF_TRUSTED_ORIGINS=https://railrush.example.com

# --- Database ---
# Running on the host (runserver, pytest) uses SQLite. The Docker stack ignores this value
# and points Django at PostgreSQL through PgBouncer.
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60

# --- Redis / Celery (host runs use in-process cache; the Docker stack sets its own URLs) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# --- Throttling (DRF rate strings) ---
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min

# --- Logging ---
LOG_LEVEL=INFO

# --- Docker stack (Phase 2) ---
POSTGRES_USER=railrush
POSTGRES_DB=railrush
# pragma: allowlist nextline secret
POSTGRES_PASSWORD=change-me-generated-by-bootstrap
# pragma: allowlist nextline secret
REDIS_PASSWORD=change-me-generated-by-bootstrap
PGBOUNCER_IMAGE=edoburu/pgbouncer:chosen-by-bootstrap
# Process model (Phase 8 compares these): threads by default, or ASGI workers.
WEB_CONCURRENCY=3
GUNICORN_THREADS=16
GUNICORN_WORKER_CLASS=gthread
APP_MODULE=config.wsgi:application
# Local stack is plain HTTP. Set to true once TLS terminates in front of nginx.
SECURE_SSL_REDIRECT=false
# Host port nginx is published on (127.0.0.1 only). Change it if 8080 is already taken.
NGINX_HOST_PORT=8080

# --- Payments (Phase 7) ---
# The mock gateway signs webhooks with this secret (HMAC-SHA256). Empty means webhooks are refused.
PAYMENT_PROVIDER=mock
# pragma: allowlist nextline secret
PAYMENT_WEBHOOK_SECRET=change-me-generated-by-bootstrap
# Seconds a booking reserves its seats while the buyer pays.
BOOKING_PAYMENT_SECONDS=600

# --- Waiting room and throttles (Phase 8) ---
# Admissions per second PER RUN (each run has its own queue). Size it from docs/CAPACITY.md: 50 suits a large deployment, not a small one.
WAITROOM_ADMIT_PER_SECOND=50
# One Redis call per throttle instead of DRF's cache get plus set. Set false to fall back to DRF's own throttles.
FAST_THROTTLES=true
