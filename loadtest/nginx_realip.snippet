        # LOAD TEST ONLY. Trust the forwarded client address from the private Docker network, so one
        # load generator can present many client addresses. Never use this file in production.
        set_real_ip_from 10.0.0.0/8;
        set_real_ip_from 172.16.0.0/12;
        set_real_ip_from 192.168.0.0/16;
        real_ip_header X-Forwarded-For;
        real_ip_recursive on;
