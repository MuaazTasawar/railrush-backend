                       "id":  1,
                       "title":  "Requests per second",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  8,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(rate(django_http_responses_total_by_status_total[1m]))",
                                           "legendFormat":  "all",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prometheus"
                                                          }
                                       },
                                       {
                                           "refId":  "B",
                                           "expr":  "sum(rate(django_http_responses_total_by_status_total{status=\"429\"}[1m]))",
                                           "legendFormat":  "throttled (429)",
                                           "datasource":  {
